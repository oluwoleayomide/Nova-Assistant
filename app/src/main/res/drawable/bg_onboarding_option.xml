<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#0D1F3C" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="#00D4FF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#0D1F3C" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#0099CC" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#111C35" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#1A2A4A" />
        </shape>
    </item>
</selector>
